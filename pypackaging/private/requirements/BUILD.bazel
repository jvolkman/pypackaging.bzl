load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

# Implementation details. Consumers must load the public entrypoint
# //:pypackaging.bzl and depend on the //:pypackaging bzl_library.
package(default_visibility = [
    "//:__pkg__",
    "//pypackaging/private:__subpackages__",
])

bzl_library(
    name = "requirements",
    srcs = ["requirements.bzl"],
    deps = [
        "//pypackaging/private/markers",
        "//pypackaging/private/specifiers",
        "//pypackaging/private/utils",
        "//pypackaging/private/version",
    ],
)
